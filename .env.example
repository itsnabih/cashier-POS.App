# ============================================================
# BabyPOS Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/babypos

# JWT Secret (WAJIB ganti di production!)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti-dengan-random-secret-yang-panjang-minimal-64-karakter

# App Config
NEXT_PUBLIC_APP_NAME=BabyPOS
NEXT_PUBLIC_APP_URL=http://localhost:3000
